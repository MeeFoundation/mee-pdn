{
  "network": [
    {
      "action": "allow",
      "host": "*",
      "method": "GET"
    },
    {
      "action": "allow",
      "host": "registry-1.docker.io",
      "method": "HEAD",
      "comment": "Image pulls of the devcontainer's Docker daemon: BuildKit asks for manifests with HEAD"
    },
    {
      "action": "allow",
      "host": "*.openai.com",
      "comment": "Allow Codex API and authentication traffic"
    },
    {
      "action": "allow",
      "host": "*.openai.org",
      "comment": "Allow Codex authentication traffic"
    },
    {
      "action": "allow",
      "host": "*.chatgpt.com",
      "comment": "Allow Codex ChatGPT login and subscription traffic"
    },
    {
      "action": "allow",
      "host": "chatgpt.com",
      "comment": "Allow Codex ChatGPT login and subscription traffic"
    },
    {
      "action": "allow",
      "host": "127.0.0.1",
      "comment": "Allow localhost traffic"
    }
  ]
}
